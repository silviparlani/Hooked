# Firebase web app configuration. These identify the Firebase project; security
# is enforced by Authentication plus Firestore rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Keep emulator use explicit so automated/local work cannot silently target production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Public Cloudinary browser-upload configuration.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Server-only Cloudinary deletion credentials. Never prefix these with NEXT_PUBLIC_.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
